# Токен бота от @BotFather.
# У этого же бота обязательно включи Business Mode:
# @BotFather → /mybots → бот → Bot Settings → Business Mode → Enable.
# Без него бот не появится в списке в «Автоматизация чатов».
BOT_TOKEN=

# Владельцы бота: им доступен /admin — статистика, баннер меню, рассылка.
ADMIN_IDS=

# Кто имеет право подключать бота к своему Telegram Business, через запятую.
# Пусто = любой, кто найдёт бота. Для личного автоответчика впиши свой id.
ALLOWED_IDS=

# Необязательное: куда класть базу. Хостинги обычно сами дают DATA_DIR.
# DB_PATH=data/autochat.db

# Обязательная подписка на основной канал — в основном боте и во всех
# зеркалах. Основной бот должен быть админом канала. 0 — выключить.
REQUIRED_CHANNEL=-1003552364867
# Ссылка на канал, если у него нет юзернейма и бот не может выпустить
# приглашение сам (нет права приглашать).
# REQUIRED_CHANNEL_URL=https://t.me/+xxxx

# Зеркала: сколько ботов может подключить один человек. 0 — выключить.
# Создание «в 2 касания» работает, если у основного бота включено
# управление ботами: @BotFather → Mini App → бот → Bot Settings.
MIRRORS_PER_OWNER=3
