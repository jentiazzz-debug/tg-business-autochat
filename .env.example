# Токен бота от @BotFather.
# У этого же бота обязательно включи Business Mode:
# @BotFather → /mybots → бот → Bot Settings → Business Mode → Enable.
# Без него бот не появится в списке в «Автоматизация чатов».
BOT_TOKEN=

# Кто имеет право подключать бота к своему Telegram Business, через запятую.
# Пусто = любой, кто найдёт бота. Для личного автоответчика впиши свой id.
ALLOWED_IDS=

# Необязательное: куда класть базу. Хостинги обычно сами дают DATA_DIR.
# DB_PATH=data/autochat.db
